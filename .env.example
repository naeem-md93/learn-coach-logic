PROJECT_HOST="0.0.0.0"
PROJECT_PORT="8001"

# Logging verbosity for lc_logic's own loggers (and the request-logging
# middleware). One of the standard levels: DEBUG, INFO, WARNING, ERROR,
# CRITICAL. Defaults to INFO if unset or invalid. DEBUG additionally logs a
# short (few-hundred-char) preview of PDF leading-text sent to Gemini for
# title extraction — never the full text, and never the API key.
# LOG_LEVEL="INFO"

# Required for POST /extract-title (and any future Gemini calls) to work.
# Get a key from https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=""

# Optional overrides:
# Default is "gemini-flash-latest" (Google's rolling alias for the current
# stable Flash model). Google periodically retires dated model IDs (e.g.
# "gemini-2.5-flash" stopped working for new users in Sep 2026) -- if this
# ever 404s again, check https://ai.google.dev/gemini-api/docs/models for a
# current model ID and override here rather than trusting any model name
# suggested inside an error message.
# GEMINI_TITLE_MODEL="gemini-flash-latest"
